{
  "name": "simple-agentic-roadmap-skill",
  "version": "1.5.0",
  "description": "A Now/Next/Later roadmap kept as one Markdown file per item, checked in CI.",
  "keywords": [
    "roadmap",
    "agent",
    "claude-code",
    "skill",
    "now-next-later",
    "markdown",
    "openspec",
    "ci"
  ],
  "license": "MIT",
  "author": "Tommy Derngren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carby/simple-agentic-roadmap-skill.git"
  },
  "homepage": "https://github.com/carby/simple-agentic-roadmap-skill#readme",
  "bugs": {
    "url": "https://github.com/carby/simple-agentic-roadmap-skill/issues"
  },
  "type": "module",
  "bin": {
    "roadmap": "bin/roadmap.js"
  },
  "files": [
    "dist",
    "bin",
    "SKILL.md",
    "references",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "lint": "biome ci .",
    "dogfood": "node scripts/dogfood.mjs",
    "prepack": "npm run build",
    "bundle": "npm run build && esbuild bin/roadmap.js --bundle --platform=node --format=esm --outfile=build/roadmap.mjs --log-level=warning"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^22.19.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
