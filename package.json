{
  "name": "simple-agentic-roadmap-skill",
  "version": "1.5.0",
  "private": true,
  "description": "A Now/Next/Later roadmap kept as one Markdown file per item, checked in CI.",
  "license": "MIT",
  "author": "Tommy Derngren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carby/simple-agentic-roadmap-skill.git"
  },
  "type": "module",
  "bin": {
    "roadmap": "bin/roadmap.js"
  },
  "files": [
    "dist",
    "bin",
    "SKILL.md",
    "references",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome ci .",
    "dogfood": "node scripts/dogfood.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
